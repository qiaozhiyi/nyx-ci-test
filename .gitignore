/target
**/*.rs.bk
node_modules/
dist/
.DS_Store
*.bin
*.shellcode
# keep Cargo.lock for this binary/product workspace

.superpowers/
# agent/session working scratch (transcripts, run logs, reports) — never commit
.agents/
# per-standalone-crate build artifacts (also covers deeper nesting like
# crates/nyx-loader/pic-loader/target/ which the single-level pattern missed)
crates/*/target/
crates/*/*/target/
tools/*/target/
# dev junk at repo root
/librust_out.rmeta
/ui.log
/screenshot*.png
.claude/worktrees/
target/drivers/
# zcode agent working scratch (plans, transcripts) — never commit
.zcode/
# downloaded artifacts during testing — never commit
downloads/
crates/client-ui-web/node_modules/
crates/client-ui-web/dist/
tmp/

# Playwright MCP test artifacts
.playwright-mcp/

# test fixtures intentionally named *.bin (embed! round-trip)
!crates/config/tests/fixtures/*.bin
