target/drivers/
# zcode agent working scratch (plans, transcripts) — never commit
.zcode/
# downloaded artifacts during testing — never commit
downloads/
crates/client-ui-web/node_modules/
crates/client-ui-web/dist/
tmp/

# IDE / agent / editor working dirs — never commit (kept on disk)
.idea/
.jules/
.omp/
.claude/agents/
